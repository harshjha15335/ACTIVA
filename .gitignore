# Union of the m1/m2/m3 branch rules, so their files land on main unchanged.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.env
.env.*
!.env.example
.ipynb_checkpoints/

# Large or private assets: never commit (guide A6).
dev_cache/
data/
tmp/
outputs/*
!outputs/README.md
weights/*
!weights/README.md
!weights/README_weights.md
# Third-party model source, unmodified at the pinned commits (D-d, #25/#26); not the checkpoints.
!weights/m1/
weights/m1/*
!weights/m1/actionformer_release/
!weights/m1/epic-kitchens-slowfast/
weights/m1/*/.git/
*.mp4
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.pkl
*.tar.gz

# Official student kit: keep local until we confirm it may go in a public repo
# (team decision 15 Nov, D19: copy supported_classes.json from your own kit).
kit/*
!kit/README.md
