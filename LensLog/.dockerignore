# Build context for the Dockerfile: code, docs, the two kit files and the committed
# weight pieces (weights/parts/). The build joins the pieces and checks each SHA-256;
# locally installed weight files are left out on purpose.
.git
.github
.venv
**/__pycache__
.pytest_cache
data
dev_cache
tmp
outputs
kit/*
!kit/manifest.csv
!kit/supported_classes.json
eval
kaggle
weights/*
!weights/README_weights.md
!weights/parts
!weights/m1
weights/m1/*
!weights/m1/actionformer_release
!weights/m1/epic-kitchens-slowfast
weights/m1/**/.git
