# Shell scripts must keep LF endings or they fail on Linux (guide B7).
* text=auto
*.sh text eol=lf
*.py text eol=lf
# Byte-exact files: never convert line endings, or the SHA-256 checks fail.
weights/parts/* binary
kit/manifest.csv -text
kit/supported_classes.json -text

# The final outputs: stored and checked out byte for byte, so comparisons are exact.
outputs/*.json -text
